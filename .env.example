# Local development only. As an add-on, the Supervisor provides SUPERVISOR_TOKEN instead.
# Copy to .env (git-ignored) and fill in.

# Base URL of Home Assistant, without a trailing slash, e.g. http://homeassistant.local:8123
HA_URL=
# Long-lived access token (HA profile -> Security -> Long-lived access tokens)
HA_TOKEN=
# Optional: where the overlay JSON lives. Default ../data/overlay.json (git-ignored);
# in the add-on /config/overlay.json.
OVERLAY_FILE=
# Optional: true starts an invented demo home in memory instead of connecting to HA
# (no HA_URL/HA_TOKEN needed, nothing is saved). See docs/setup.md.
HOMEACE_DEMO=
